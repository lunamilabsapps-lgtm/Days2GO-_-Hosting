      "h2": "text-xl md:text-2xl font-bold tracking-tight",
      "h3": "text-lg md:text-xl font-semibold",
      "h4": "text-base font-semibold",
      "body": "text-sm leading-relaxed",
      "caption": "text-xs font-mono tracking-wide uppercase"
    }
  },
  "colors": {
