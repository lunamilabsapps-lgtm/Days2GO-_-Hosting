{
  "project_identity": {
    "name": "Bright Coda Local Business Scout",
    "tagline": "Autonomous Local Prospecting & Email Outreach Command Platform",
    "theme_mode": "dark_light_switchable",
    "default_theme": "dark",
    "design_archetype": "Swiss Tactical Command Center & Autonomous Agent Operating System"
