  "instructions_to_main_agent": [
    "Build a clean, polished, dark/light compatible React SaaS application using Tailwind CSS & Lucide icons.",
    "Do NOT use TypeScript file extensions - use standard JavaScript (.js / .jsx) components.",
    "Ensure all components gracefully handle dark mode switching via a theme provider (using dark class on root).",
    "Implement the live agent activity view with streaming logs, pause/resume/stop buttons, step-by-step progress cards, and real-time animation pulses.",
    "Ensure every reply item displays the required prominent GREEN REPLIED tag with custom emerald styling.",
    "Include data-testid on every single button, form field, tab, table row, nav link, and action element."
  ]
}