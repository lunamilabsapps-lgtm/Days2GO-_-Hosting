  "layout_and_navigation": {
    "sidebar_width": "w-64",
    "navigation_items": [
      { "id": "dashboard", "label": "Dashboard", "icon": "LayoutDashboard" },
      { "id": "new_search", "label": "New Search", "icon": "Search" },
      { "id": "live_agent", "label": "Live Agent Activity", "icon": "Activity" },
      { "id": "coverage_map", "label": "Geographic Coverage", "icon": "MapPin" },
      { "id": "prospects", "label": "Prospects", "icon": "Users" },
      { "id": "assessments", "label": "Website Assessments", "icon": "Globe" },
      { "id": "campaigns", "label": "Email Campaigns", "icon": "Mail" },
      { "id": "replies", "label": "Replies", "icon": "MessageSquare", "badge": "GREEN_TAG" },
      { "id": "notifications", "label": "Notifications", "icon": "Bell" },
      { "id": "service_catalogue", "label": "Service Catalogue", "icon": "BookOpen" },
      { "id": "integrations", "label": "Integrations", "icon": "Cpu" },
      { "id": "settings", "label": "Settings", "icon": "Settings" }
    ],
    "topbar_elements": [
      "Agent Status Pill (Active / Paused / Idle with live pulsing indicator)",
      "Global Search bar for Suburbs & Prospects",
      "Cost Tracking Counter badge ($ spend, tokens consumed)",
      "Dark / Light theme toggle switch",
      "Notification bell with unread indicator dot",
      "User avatar & profile dropdown"
    ]
  },
  "key_screens_and_components": {
    "live_agent_activity_dashboard": {
      "hero_working_panel": {
        "description": "Large prominent card showing the exact prospect being scanned right now in real time.",
        "fields": [
          "Business Name & Industry Category Badge",
          "Suburb & Address Tag",
          "Website URL & Live Screenshot Preview Container",
          "Current Stage Pipeline (Suburb Discovery -> OSM Scrape -> Dedupe -> AI Web Audit -> Lead Scoring -> Email Personalization)",
          "AI Audit Findings Bullets (Tech stack, SEO rating, value prop match, missing contact info)",
          "Contact Status & Found Email/Phone",
          "Lead Score Gauge (1-100 with A/B/C/D Grade Badge)",
          "Generated Email Preview snippet",
          "Control Bar: Pause, Resume, Stop Agent, Step Speed Selector (1x, 2x, Fast-Forward)"
        ]
      },
      "streaming_activity_timeline": {
        "description": "Live feed panel displaying step-by-step agent logs with timestamps, icons, color-coded event severity, and collapsible tool output receipts.",
        "features": ["Filter by log type (Scrapes, Audits, Emails, Errors)", "Auto-scroll toggle", "Expand log JSON/data"]
      }
    },
    "stats_grid_11_metrics": [
      { "id": "suburbs_discovered", "title": "Suburbs Discovered", "format": "number" },
      { "id": "active_searches", "title": "Active Suburb Searches", "format": "number" },
      { "id": "businesses_scraped", "title": "Businesses Scraped", "format": "number" },
      { "id": "deduplicated_count", "title": "Deduplicated Leads", "format": "number" },
      { "id": "grade_a_leads", "title": "Grade A Prospects", "format": "number_badge", "color": "emerald" },
      { "id": "grade_b_c_d_leads", "title": "Grade B / C / D Breakdown", "format": "bar_breakdown" },
      { "id": "emails_drafted", "title": "Emails Personalised", "format": "number" },
      { "id": "emails_approved_sent", "title": "Emails Approved & Sent", "format": "number" },
      { "id": "open_rate", "title": "Email Open Rate", "format": "percentage" },
      { "id": "reply_rate", "title": "Reply Rate", "format": "percentage" },
      { "id": "cost_spend", "title": "API & LLM Spend", "format": "currency" }
    ],
    "geographic_coverage_map": {
      "library": "Leaflet.js / react-leaflet",
      "suburb_statuses": {
        "unsearched": { "color": "#64748B", "label": "Unsearched" },
        "searching": { "color": "#06B6D4", "label": "Searching Now", "pulse": true },
        "completed": { "color": "#10B981", "label": "Completed" },
        "needs_research": { "color": "#F59E0B", "label": "Needs Research" }
      },
      "overlay_features": ["Prospect count chips on suburb centroids", "Click suburb to open Suburb Detail Drawer", "Search query bounding box visualization"]
    },
    "replies_screen": {
      "must_have": "PROMINENT GREEN REPLIED TAG on reply cards and email threads.",
      "tag_styling": "bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 font-bold text-xs px-2.5 py-1 rounded-full uppercase tracking-wider flex items-center gap-1.5",
      "features": ["AI Sentiment analysis tag (Interested, Question, Not Interested, Opt-Out)", "Quick Reply drafting box", "Mark as Handled toggle"]
    }
  },
  "testing_and_accessibility": {
    "data_testid_policy": "ALL interactive elements, buttons, inputs, navigation links, status indicators, tabs, modal triggers, map suburb overlays, and table rows MUST have explicit data-testid attributes.",
